#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


[ -d "/client/dist" ] && python manage.py collectstatic --noinput || echo "Client Folder not built skipping collect static"

# The deploy migrates before rollout (`terraform_data.migrate`); a web task never writes the
# schema, and refuses to start if a migration is still pending.
python manage.py migrate --check

gunicorn {{ cookiecutter.project_slug }}.asgi:application \
  -k uvicorn.workers.UvicornWorker \
  --bind 0.0.0.0:${PORT:-8000} \
  --workers ${WEB_CONCURRENCY:-2} \
  --timeout ${GUNICORN_TIMEOUT:-120} \
  --access-logfile - \
  --error-logfile -
